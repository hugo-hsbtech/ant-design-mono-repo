{
  "name": "@repo/brand-tokens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/brand.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:tokens": "node ./scripts/build-tokens.mjs",
    "tokens:import": "node ./scripts/import-figma-tokens.mjs",
    "build": "pnpm build:tokens && tsup",
    "dev": "pnpm build:tokens && tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo src/__generated__"
  },
  "peerDependencies": {
    "antd": "^5.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/test-config": "workspace:*",
    "@repo/tsup-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "antd": "^5.22.5",
    "eslint": "^9.17.0",
    "style-dictionary": "^4.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
