{
  "name": "plataforma",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de UI sobre Ant Design v5 — dashboards/SaaS, landing pages e sites institucionais com identidade de marca unificada.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:storybook": "turbo run test:storybook",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "coverage:report": "node ./scripts/coverage-summary.mjs",
    "build:storybook": "turbo run build:storybook",
    "gen": "turbo gen",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@turbo/gen": "^2.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
